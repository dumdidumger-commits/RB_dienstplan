# Kuerzel-Mapping fuer die "Ist"-Spalte aus dem Vivendi-Export.
#
# Kopiere diese Datei zu "kuerzel_mapping.yaml" (ohne .example) und passe sie an - das Add-on
# liest nur die Datei ohne .example. So bleiben deine Anpassungen bei einem Add-on-Update
# unangetastet.
#
# Aufbau:
#   exact:   genaue Codes aus der Ist-Spalte (Gross-/Kleinschreibung wird ignoriert). Hat
#            immer Vorrang vor "prefix".
#   prefix:  Fallback ueber den ERSTEN Buchstaben, falls kein exakter Treffer in "exact"
#            existiert - das deckt neue/unbekannte Team-Kuerzel automatisch ab (z.B. "F12"
#            faellt automatisch unter "F" -> Fruehschicht), ohne dass du jeden einzelnen
#            Teamcode einzeln eintragen musst.
#
# Jeder Eintrag ist entweder:
#   - ein Text (= Schicht-Bezeichnung, wird im Kalender-Titel verwendet), oder
#   - null (= "kein Kalendereintrag", z.B. freie Tage)
#
# "SF" und "TB" vom Nutzer bestaetigt (2026-07-30): SF = Sonderfunktion, TB = Teambesprechung.
# "Ut" vom Nutzer bestaetigt (30.07.2026, nach 1. echtem Testlauf): Urlaubstag.
# "U2" und "kfE" (30.07.2026): Bedeutung dem Nutzer selbst gerade nicht bekannt - auf
# ausdruecklichen Wunsch 1:1 mit dem Kuerzel als Bezeichnung uebernommen (inkl. Uhrzeiten, falls
# im Export welche stehen - das macht calendar_sync.py automatisch fuer jeden Eintrag mit
# Start/Ende). Bei Gelegenheit hier durch die echte Bezeichnung ersetzen.
# "" (leerer Code, ebenfalls im 1. Testlauf aufgefallen): wie "/" als "kein Kalendereintrag"
# behandelt statt als unbekannt zu loggen - ein leerer Ist-Code bedeutet vermutlich dasselbe
# wie ein freier Tag.

exact:
  "!": null          # gesonderter Vermerk - laut Spezifikation kein Kalendereintrag, wird aber geloggt
  "/": null           # frei
  "": null            # leerer Code - wie "/" behandelt
  "BB": "Bewohnerbesprechung"
  "TB": "Teambesprechung"
  "SF": "Sonderfunktion"
  "Ut": "Urlaubstag"
  "U2": "U2"          # Bedeutung noch offen, bewusst 1:1 uebernommen
  "kfE": "kfE"         # Bedeutung noch offen, bewusst 1:1 uebernommen

prefix:
  "F": "Fruehschicht"
  "S": "Spaetschicht"
  # "FZA" wird durch das Prefix "F" eigentlich auch erfasst (faelschlich als Fruehschicht) -
  # deshalb hier ein exakter Vorrang-Eintrag noetig fuer alle "FZA ..."-Codes:

exact_prefix_override:
  # Codes, die mit diesem Text BEGINNEN, werden auf null (kein Eintrag) gemappt - hat Vorrang
  # vor "prefix" oben, aber wird erst nach "exact" geprueft. Deckt "FZA So", "FZA Mo" usw. ab,
  # ohne jede Kombination einzeln auflisten zu muessen.
  "FZA": null
